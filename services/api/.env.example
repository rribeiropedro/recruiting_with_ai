# ─── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Project Settings → API → anon public
SUPABASE_ANON_KEY=

# Project Settings → API → service_role  (never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=

# Project Settings → Database → Connection string → URI (port 5432)
# If your password contains special characters, URL-encode them: [ → %5B, ] → %5D, @ → %40
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.xxxxxxxxxxxxxxxxxxxx.supabase.co:5432/postgres

# Project Settings → Database → Transaction pooler URI (port 6543) — used by Celery workers
DATABASE_URL_POOLED=postgresql+asyncpg://postgres.xxxxxxxxxxxxxxxxxxxx:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local dev: redis://localhost:6379
# Railway managed Redis: injected automatically as $REDIS_URL — no value needed in production
REDIS_URL=redis://localhost:6379

# ─── LLM APIs ─────────────────────────────────────────────────────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-

# platform.openai.com → API Keys (used for text-embedding-3-small)
OPENAI_API_KEY=sk-

# ─── Email Discovery (Outreach pipeline — leave blank until pipeline is built) ─
# hunter.io → API → API Key
HUNTER_API_KEY=

# apollo.io → Settings → Integrations → API Keys
APOLLO_API_KEY=

# ─── Google OAuth (Outreach pipeline — leave blank until pipeline is built) ───
# console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate once and keep secret. Run:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─── App Config ───────────────────────────────────────────────────────────────
# Similarity threshold for resume cache hits (0.0–1.0, default 0.88)
CACHE_SIMILARITY_THRESHOLD=0.88

# development | production
ENVIRONMENT=development

# URL of the Next.js frontend (used for CORS)
FRONTEND_URL=http://localhost:3000
